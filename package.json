{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "description": "SVG Editor CLI — Lab1 Phase 1",
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.tests.json && node --test dist/tests/tests/smoke.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  }
}
